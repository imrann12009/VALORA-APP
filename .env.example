EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_AUTH_REDIRECT_URL=https://your-production-domain.com
EXPO_PUBLIC_DEV_AUTH_REDIRECT_URL=http://localhost:8083

# Configure these secrets only in Supabase Dashboard / provider dashboards, never in frontend source:
# GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET
# FACEBOOK_APP_ID
# FACEBOOK_APP_SECRET
# SMS_PROVIDER_ACCOUNT_SID
# SMS_PROVIDER_AUTH_TOKEN
# SMS_PROVIDER_FROM_NUMBER
